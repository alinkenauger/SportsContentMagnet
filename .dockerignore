# CRITICAL: Exclude ALL cache and Python files (5.4GB+)
.cache
.cache/**
.pythonlibs
.pythonlibs/**
__pycache__
__pycache__/**
*.pyc
*.pyo
*.pyd
.Python
.uv
.uv/**
*/uv/**
**/uv/**

# Development and version control
.git/**
.gitignore
.github/**
*.md
!README.md

# Python/ML libraries (massive files)
**/*torch*
**/*cuda*
**/*nvidia*
**/*triton*
**/*cupti*
**/*nccl*
**/*cudnn*
**/*.so
**/*.a
**/lib*.so.*

# Node development (but NOT node_modules - we need that!)
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm/**
.yarn/**

# Build outputs
dist/**
build/**
*.log

# IDE and editor files
.vscode/**
.idea/**
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp
.temp/**
.tmp/**
tmp/**
temp/**

# Test files
test/**
tests/**
*.test.js
*.spec.js
coverage/**
.nyc_output/**

# Development scripts
deploy*.sh
cleanup*.sh
build*.sh
fix*.sh
deployment*.sh
validate*.sh
*.sh

# Documentation
docs/**
documentation/**
*.pdf
DEPLOYMENT*.md

# Python specific
pyproject.toml
poetry.lock
Pipfile
Pipfile.lock
requirements*.txt
uv.lock
server/**/*.py
*.py

# Large assets
external_storage/**
attached_assets/**
public/screenshots/**
public/uploads/**
*.mp4
*.mp3
*.wav
*.avi
*.mov
*.zip
*.tar
*.gz
*.rar

# Development config
.env.local
.env.development
.env.test
*.local

# Backup files
*backup*
*original*
*-old*
*-bak*
package-*.json
!package.json

# Package manager files (except package.json)
package-lock.json
yarn.lock
pnpm-lock.yaml

# Dockerfiles and configs not needed in image
Dockerfile*
docker-compose*
.dockerignore*

# Development tools config
.eslintrc*
.prettierrc*
.stylelintrc*
.babelrc*
jest.config*
webpack.config*
rollup.config*
tsconfig.tsbuildinfo

# CI/CD
.travis.yml
