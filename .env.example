# Database Configuration
DATABASE_URL=your_postgres_connection_string

# Session Configuration
SESSION_SECRET=your_session_secret_here

# Admin Configuration
# Comma-separated list of admin user IDs and emails
ADMIN_USER_IDS=user_id_1,user_id_2
ADMIN_EMAILS=admin1@example.com,admin2@example.com

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
VITE_STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key

# OpenAI Configuration
OPENAI_API_KEY=sk-your_openai_api_key

# YouTube API Configuration
YOUTUBE_API_KEY=your_youtube_api_key

# SendGrid Configuration
SENDGRID_API_KEY=SG.your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@yourdomain.com
SENDGRID_FROM_NAME=Your App Name

# SendGrid Template IDs
SENDGRID_WELCOME_TEMPLATE_ID=d-your_welcome_template_id
SENDGRID_RESET_TEMPLATE_ID=d-your_reset_template_id
SENDGRID_VERIFICATION_TEMPLATE_ID=d-your_verification_template_id
SENDGRID_GUIDE_DELIVERY_TEMPLATE_ID=d-your_guide_delivery_template_id
SENDGRID_BRAND_INVITE_TEMPLATE_ID=d-your_brand_invite_template_id

# Google OAuth Configuration (Optional)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# High Level CRM Configuration (Optional)
HIGH_LEVEL_API_KEY=your_high_level_api_key
HIGH_LEVEL_LOCATION_ID=your_location_id

# Deployment Configuration
NODE_ENV=development
PORT=3000

# Feature Flags for Production
USE_LIGHTWEIGHT_SERVICES=false
DISABLE_IMAGE_PROCESSING=false
DISABLE_PDF_GENERATION=false
DISABLE_AUDIO_PROCESSING=false

# Storage Configuration
STORAGE_COST_PER_GB_MONTH=0.10
STORAGE_CLEANUP_DAYS=30

# Application URLs
APP_URL=http://localhost:3000
API_URL=http://localhost:3000