<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{title}}</title>
  <style>
    :root { --primary: {{primaryColor}}; --secondary: {{secondaryColor}}; --ink: #172033; --muted: #5b6474; --line: #dfe5ee; --soft: #f6f8fb; }
    * { box-sizing: border-box; }
    body { margin: 0; background: #eef2f6; color: var(--ink); font: 15px/1.65 Arial, Helvetica, sans-serif; }
    .page { width: min(920px, calc(100% - 32px)); margin: 24px auto; background: white; box-shadow: 0 18px 54px rgba(23, 32, 51, .12); }
    .cover { position: relative; overflow: hidden; min-height: 430px; padding: 56px; color: white; background: linear-gradient(135deg, var(--primary), var(--secondary)); }
    .cover::after { content: ""; position: absolute; width: 360px; height: 360px; right: -120px; bottom: -180px; border: 80px solid rgba(255,255,255,.13); border-radius: 50%; }
    .brand { display: flex; align-items: center; gap: 14px; font-size: 13px; font-weight: 700; letter-spacing: .05em; text-transform: uppercase; }
    .logo { display: grid; place-items: center; width: 48px; height: 48px; border-radius: 14px; object-fit: contain; background: white; color: var(--primary); font-size: 20px; }
    .cover h1 { position: relative; z-index: 1; max-width: 700px; margin: 84px 0 16px; font-size: 46px; line-height: 1.05; letter-spacing: -.035em; }
    .cover .description { position: relative; z-index: 1; max-width: 640px; margin: 0; font-size: 18px; color: rgba(255,255,255,.86); }
    .cover .promise { position: relative; z-index: 1; max-width: 650px; margin-top: 32px; padding: 16px 18px; border: 1px solid rgba(255,255,255,.25); border-radius: 14px; background: rgba(255,255,255,.12); }
    main { padding: 48px 56px 64px; }
    h2, h3, p { margin-top: 0; }
    h2 { line-height: 1.18; }
    h3 { line-height: 1.3; }
    .eyebrow { margin-bottom: 7px; color: var(--primary); font-size: 11px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
    .introduction { margin: 0 0 46px; padding-left: 20px; border-left: 4px solid var(--secondary); font-size: 17px; color: #374151; }
    .quick-start { margin-bottom: 46px; padding: 26px; border: 1px solid color-mix(in srgb, var(--primary) 24%, white); border-radius: 18px; background: color-mix(in srgb, var(--primary) 6%, white); }
    .quick-start h2 { margin-bottom: 14px; }
    .section { margin-top: 52px; break-inside: auto; }
    .section-title { margin: 0 0 16px; padding-bottom: 12px; border-bottom: 2px solid var(--primary); color: var(--ink); font-size: 27px; }
    .objective { color: var(--muted); }
    .source-refs { margin: 12px 0 20px; padding: 10px 12px; border-radius: 8px; background: var(--soft); color: var(--muted); font-size: 12px; }
    .source-refs a { color: var(--primary); }
    .blocks { display: grid; gap: 18px; }
    .prose-block { white-space: normal; }
    .artifact-block, .callout, .milestone, .template { break-inside: avoid; padding: 20px; border: 1px solid var(--line); border-radius: 14px; }
    .artifact-block h3, .callout h3 { margin-bottom: 13px; }
    .steps { display: grid; gap: 13px; margin: 0; padding-left: 24px; }
    .steps > li { padding: 15px; border-radius: 10px; background: var(--soft); }
    .step-heading { display: flex; justify-content: space-between; gap: 12px; }
    .step-heading span { color: var(--muted); font-size: 12px; white-space: nowrap; }
    .note, .success, .warning { margin: 10px 0 0; padding: 10px 12px; border-radius: 8px; font-size: 13px; }
    .note { background: #eef4ff; }
    .success { background: #ecfdf5; color: #14532d; }
    .warning { background: #fff7ed; color: #7c2d12; }
    .checklist { display: grid; gap: 12px; margin: 0; padding: 0; list-style: none; }
    .checklist li { display: flex; gap: 11px; }
    .checkbox { width: 18px; height: 18px; margin-top: 3px; flex: 0 0 auto; border: 2px solid var(--secondary); border-radius: 5px; }
    .checklist p { margin: 3px 0 0; color: var(--muted); font-size: 13px; }
    .worksheet-prompt { margin-top: 20px; }
    .answer-space { height: 42px; margin-top: 9px; border-bottom: 1px solid #9aa5b5; }
    .answer-space-long { height: 105px; background: repeating-linear-gradient(white 0, white 32px, #dfe5ee 33px); }
    .choice-list { margin: 9px 0 0; columns: 2; }
    table { width: 100%; border-collapse: collapse; font-size: 13px; }
    th, td { padding: 10px; border: 1px solid var(--line); text-align: left; vertical-align: top; }
    th { background: var(--soft); }
    .example { display: grid; gap: 10px; }
    .trouble + .trouble { margin-top: 12px; padding-top: 12px; border-top: 1px solid var(--line); }
    .trouble p { margin: 5px 0 0; }
    .callout-tip { background: #ecfdf5; }
    .callout-warning { background: #fff7ed; }
    .callout-insight { background: #eef4ff; }
    .callout p { margin: 5px 0 0; }
    .milestone { margin-top: 16px; }
    .milestone-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
    .template { margin-top: 16px; }
    pre { overflow-wrap: anywhere; white-space: pre-wrap; padding: 16px; border-radius: 10px; background: #111827; color: #f8fafc; font: 12px/1.65 ui-monospace, SFMono-Regular, Menlo, monospace; }
    .next-action { margin-top: 20px; padding: 18px; border: 1px solid color-mix(in srgb, var(--secondary) 30%, white); border-radius: 12px; background: color-mix(in srgb, var(--secondary) 8%, white); font-weight: 700; }
    footer { padding: 28px 56px; border-top: 1px solid var(--line); background: var(--soft); color: var(--muted); font-size: 12px; }
    footer a { color: var(--primary); }
    footer .disclaimer { margin-top: 8px; }
    @media (max-width: 680px) { .cover, main, footer { padding-left: 24px; padding-right: 24px; } .cover h1 { margin-top: 58px; font-size: 36px; } .milestone-grid { grid-template-columns: 1fr; } }
    @media print {
      @page { margin: 12mm; }
      body { background: white; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
      .page { width: 100%; margin: 0; box-shadow: none; }
      .cover { min-height: 245mm; page-break-after: always; }
      .section-title, .artifact-block h3 { break-after: avoid; }
    }
  </style>
</head>
<body>
  <article class="page">
    <header class="cover">
      <div class="brand">
        {{#if logoUrl}}<img src="{{logoUrl}}" alt="{{companyName}} logo" class="logo">{{else}}<span class="logo">{{firstLetter}}</span>{{/if}}
        <span>{{companyName}}</span>
      </div>
      <h1>{{title}}</h1>
      {{#if description}}<p class="description">{{description}}</p>{{/if}}
      {{#if promise}}<p class="promise"><strong>What this helps you accomplish</strong><br>{{promise}}</p>{{/if}}
    </header>

    <main>{{{richContent}}}</main>

    <footer>
      <strong>{{companyName}}</strong>{{#if website}} · <a href="{{website}}">{{website}}</a>{{/if}}
      {{#if channelTitle}}<div>Original source: {{channelTitle}}</div>{{/if}}
      <div class="disclaimer">{{disclaimer}} · Prepared {{createdAt}}</div>
    </footer>
  </article>
</body>
</html>
