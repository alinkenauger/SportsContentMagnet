# Lightweight Dockerfile for deployment without problematic packages
FROM node:20-alpine AS builder

# Install minimal system dependencies
RUN apk add --no-cache python3 make g++

# Set working directory
WORKDIR /app

# Copy package files for lightweight deployment
COPY package-production.json package.json
COPY package-lock.json* ./

# Install only production dependencies (no puppeteer, sharp, ytdl-core)
RUN npm ci --only=production

# Copy source code (excluding heavy assets via .dockerignore)
COPY . .

# Replace heavy services with lightweight versions
RUN if [ -f "server/services/pdfGenerator.ts" ]; then \
      mv server/services/pdfGenerator.ts server/services/pdfGenerator-heavy.ts && \
      mv server/services/pdfGenerator-lite.ts server/services/pdfGenerator.ts; \
    fi

# Build the application
RUN npm run build

# Production stage - ultra lightweight
FROM node:20-alpine AS production

# Install only essential runtime dependencies
RUN apk add --no-cache python3

# Create non-root user
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nodejs -u 1001

# Set working directory
WORKDIR /app

# Copy package files for production
COPY --from=builder /app/package.json ./
COPY --from=builder /app/package-lock.json* ./

# Install only production dependencies
RUN npm ci --only=production --no-cache && \
    npm cache clean --force

# Copy built application from builder stage
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/client/dist ./client/dist

# Copy essential configuration files
COPY --from=builder /app/drizzle.config.ts ./
COPY --from=builder /app/tailwind.config.ts ./
COPY --from=builder /app/postcss.config.js ./
COPY --from=builder /app/vite.config.ts ./

# Change ownership to nodejs user
RUN chown -R nodejs:nodejs /app

# Switch to non-root user
USER nodejs

# Expose port
EXPOSE 5000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD node -e "require('http').get('http://localhost:5000/health', (res) => { process.exit(res.statusCode === 200 ? 0 : 1) })"

# Start the application
CMD ["node", "dist/index.js"]